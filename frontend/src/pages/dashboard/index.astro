---
import Layout from './_components/Layout.astro';
import devPreview from '../../themes/dev/assets/images/preview.svg?url';
import whitePagePreview from '../../themes/white-page/assets/images/preview.svg?url';
import settingsIcon from './assets/images/settings.svg?url';
import modeIcon from './assets/images/dark-light.svg?url';
import dotsIcon from './assets/images/three-dots-svgrepo-com.svg?url';
import adjectivesText from './assets/data/List_of_Adjectives.txt?raw';
import nounsText from './assets/data/List_of_Nouns.txt?raw';

const adjectives = adjectivesText.split(/\r?\n/).map((word) => word.trim()).filter(Boolean);
const nouns = nounsText.split(/\r?\n/).map((word) => word.trim()).filter(Boolean);

type Theme = {
  id: string;
  name: string;
  image?: string;
};

const themes: Theme[] = [{ id: 'dev', name: 'dev', image: devPreview }];
---

<Layout>
  <main class="dashboard-shell">
    <header class="topbar">
      <a class="brand" href="/dashboard/" aria-label="WinDesktop dashboard home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-name">WinDesktop</span>
      </a>
      <div class="topbar-actions">
        <button class="mode-button" type="button" data-mode-toggle aria-label="Use light mode" aria-pressed="false" title="Switch to light mode">
          <img src={modeIcon} alt="" aria-hidden="true" />
        </button>
        <button class="settings-button" type="button" aria-label="Settings" title="Settings coming soon">
          <img src={settingsIcon} alt="" aria-hidden="true" />
        </button>
      </div>
    </header>

    <section class="page-heading" aria-labelledby="page-title">
      <div>
        <p class="eyebrow">Theme library</p>
        <h1 id="page-title">Choose your desktop</h1>
        <p class="heading-copy">Pick a theme to make WinDesktop feel like yours.</p>
      </div>
      <label class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 5 5"></path></svg>
        <input type="search" placeholder="Search themes" aria-label="Search themes" data-theme-search />
        <kbd>/</kbd>
      </label>
    </section>

    <section class="theme-section" aria-labelledby="themes-title">
      <div class="section-heading">
        <div class="section-title"><h2 id="themes-title">All themes</h2><span class="theme-count" data-theme-count>{themes.length} theme</span></div>
        <button class="create-theme-button" type="button" data-create-theme data-adjectives={JSON.stringify(adjectives)} data-nouns={JSON.stringify(nouns)} data-white-preview={whitePagePreview}><span aria-hidden="true">+</span>Create theme</button>
      </div>
      <div class="theme-grid" data-theme-grid>
        {themes.map((theme) => (
          <article class="theme-card" data-theme-card data-theme-name={theme.name}>
            <a class="theme-card-link" href={`/themes/${theme.id}/`} aria-label={`Open ${theme.name} theme`}>
              <span class:list={["theme-preview", { "has-image": Boolean(theme.image) }]}>{theme.image && <img src={theme.image} alt="" />}</span>
              <span class="theme-card-footer"><span class="theme-name">{theme.name}</span><span class="card-arrow" aria-hidden="true">&#8599;</span></span>
            </a>
            <div class="theme-menu" data-theme-menu>
              <button class="theme-menu-button" type="button" aria-label={`Options for ${theme.name}`} aria-expanded="false" aria-haspopup="menu" data-theme-menu-button>
                <img src={dotsIcon} alt="" aria-hidden="true" />
              </button>
              <div class="theme-menu-popover" role="menu" hidden>
                <button type="button" role="menuitem" data-theme-action="edit">Edit</button>
                <button type="button" role="menuitem" data-theme-action="rename">Rename</button>
              </div>
            </div>
          </article>
        ))}
        <p class="empty-state" data-empty-state hidden>No themes found.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-theme-search]');
  let cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  const count = document.querySelector<HTMLElement>('[data-theme-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const modeButton = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  const createThemeButton = document.querySelector<HTMLButtonElement>('[data-create-theme]');
  const themeMenus = [...document.querySelectorAll<HTMLElement>('[data-theme-menu]')];

  const setMode = (mode: 'light' | 'dark') => {
    document.documentElement.dataset.theme = mode;
    modeButton?.setAttribute('aria-pressed', String(mode === 'light'));
    modeButton?.setAttribute('aria-label', `Use ${mode === 'light' ? 'dark' : 'light'} mode`);
    modeButton?.setAttribute('title', `Switch to ${mode === 'light' ? 'dark' : 'light'} mode`);
    localStorage.setItem('windesktop-theme', mode);
  };

  const savedMode = localStorage.getItem('windesktop-theme');
  setMode(savedMode === 'light' ? 'light' : 'dark');
  modeButton?.addEventListener('click', () => {
    setMode(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
  });

  const closeThemeMenus = () => {
    themeMenus.forEach((menu) => {
      menu.querySelector<HTMLButtonElement>('[data-theme-menu-button]')?.setAttribute('aria-expanded', 'false');
      const popover = menu.querySelector<HTMLElement>('.theme-menu-popover');
      if (popover) popover.hidden = true;
    });
  };

  themeMenus.forEach((menu) => {
    const menuButton = menu.querySelector<HTMLButtonElement>('[data-theme-menu-button]');
    const popover = menu.querySelector<HTMLElement>('.theme-menu-popover');
    menuButton?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      closeThemeMenus();
      if (!isOpen && popover) {
        menuButton.setAttribute('aria-expanded', 'true');
        popover.hidden = false;
      }
    });
    menu.querySelectorAll<HTMLButtonElement>('[data-theme-action]').forEach((action) => {
      action.addEventListener('click', () => closeThemeMenus());
    });
  });

  document.addEventListener('click', closeThemeMenus);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeThemeMenus();
  });
  const capitalize = (word: string) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
  const pick = (words: string[]) => words[Math.floor(Math.random() * words.length)];

  createThemeButton?.addEventListener('click', () => {
    const adjectives = JSON.parse(createThemeButton.dataset.adjectives ?? '[]') as string[];
    const nouns = JSON.parse(createThemeButton.dataset.nouns ?? '[]') as string[];
    const previewUrl = createThemeButton.dataset.whitePreview;
    if (!adjectives.length || !nouns.length) return;

    const name = `${capitalize(pick(adjectives))} ${capitalize(pick(nouns))}`;
    const card = document.createElement('article');
    card.className = 'theme-card';
    card.dataset.themeCard = '';
    card.dataset.themeName = name;

    const link = document.createElement('a');
    link.className = 'theme-card-link';
    link.href = `/themes/white-page/?name=${encodeURIComponent(name)}`;
    link.setAttribute('aria-label', `Open ${name} theme`);

    const preview = document.createElement('span');
    preview.className = 'theme-preview has-image';
    if (previewUrl) {
      const image = document.createElement('img');
      image.src = previewUrl;
      image.alt = '';
      preview.append(image);
    }
    const footer = document.createElement('span');
    footer.className = 'theme-card-footer';
    const title = document.createElement('span');
    title.className = 'theme-name';
    title.textContent = name;
    const arrow = document.createElement('span');
    arrow.className = 'card-arrow';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = '↗';
    footer.append(title, arrow);
    link.append(preview, footer);
    card.append(link);
    emptyState?.before(card);
    cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
    filterThemes();
  });

  function filterThemes() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = card.dataset.themeName?.toLowerCase().includes(query) ?? false;
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'theme' : 'themes'}`;
    if (emptyState) emptyState.hidden = visible !== 0;
  }
  search?.addEventListener('input', filterThemes);
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== search) {
      event.preventDefault();
      search?.focus();
    }
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  .dashboard-shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 31px 0 64px; }
  .topbar, .page-heading, .section-heading, .theme-card-footer { display: flex; align-items: center; }
  .topbar { justify-content: space-between; }
  .topbar-actions { display: flex; align-items: center; gap: 9px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: #f4f3f1; text-decoration: none; }
  .brand-mark { width: 29px; height: 29px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 3px; transform: rotate(-8deg); }
  .brand-mark span { border-radius: 4px; background: #55a8ff; }
  .brand-mark span:nth-child(2) { opacity: .75; } .brand-mark span:nth-child(3) { opacity: .56; } .brand-mark span:nth-child(4) { opacity: .32; }
  .brand-name { font-size: 15px; font-weight: 650; letter-spacing: -.01em; }
  .settings-button, .mode-button { width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border: 1px solid #2a2e36; border-radius: 12px; background: #1b1e24; color: #a4a7ad; cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .settings-button:hover { border-color: #444a55; color: #f4f3f1; background: #22262d; }
  .settings-button img, .mode-button img { width: 21px; height: 21px; object-fit: contain; }
  .mode-button img, .settings-button img { filter: invert(1); }
  .settings-button:hover, .mode-button:hover { border-color: #444a55; color: #f4f3f1; background: #22262d; }
  .page-heading { justify-content: space-between; gap: 32px; margin-top: 94px; }
  .eyebrow { margin: 0 0 13px; color: #55a8ff; font-size: 11px; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
  h1, h2, p { margin: 0; } h1 { color: #f4f3f1; font-size: clamp(36px, 5vw, 58px); font-weight: 600; letter-spacing: -.055em; line-height: .98; }
  .heading-copy { margin-top: 17px; color: #8b8e96; font-size: 15px; }
  .search-field { width: min(100%, 292px); height: 46px; flex: 0 0 auto; display: flex; align-items: center; gap: 11px; padding: 0 12px 0 15px; border: 1px solid #2d3139; border-radius: 13px; background: #1a1d23; color: #878b94; transition: border-color .2s, box-shadow .2s; }
  .search-field:focus-within { border-color: #4779a8; box-shadow: 0 0 0 3px rgba(85, 168, 255, .1); }
  .search-field svg { width: 17px; height: 17px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .search-field input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #f4f3f1; font: inherit; font-size: 13px; }
  .search-field input::placeholder { color: #737780; } .search-field kbd { padding: 3px 6px; border: 1px solid #343841; border-radius: 5px; color: #737780; font: 11px/1.1 inherit; }
  .theme-section { margin-top: 77px; } .section-heading { justify-content: space-between; gap: 12px; margin-bottom: 20px; } .section-title { display: flex; align-items: center; gap: 12px; } h2 { color: #e8e7e3; font-size: 14px; font-weight: 600; letter-spacing: -.01em; } .theme-count { color: #6f737c; font-size: 12px; }
  .create-theme-button { display: inline-flex; align-items: center; gap: 7px; padding: 9px 13px; border: 1px solid #2f5275; border-radius: 9px; background: #1b2b3d; color: #8fc9ff; font: inherit; font-size: 12px; font-weight: 650; cursor: pointer; transition: border-color .2s, background .2s, color .2s; } .create-theme-button span { font-size: 17px; font-weight: 400; line-height: .7; } .create-theme-button:hover { border-color: #55a8ff; background: #233e58; color: #d7edff; }
  .theme-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(235px, 1fr)); gap: 17px; }
  .theme-card { position: relative; min-height: 248px; overflow: hidden; border: 1px solid #2c3038; border-radius: 17px; background: #1b1e24; color: inherit; text-align: left; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .theme-card:hover { border-color: #4779a8; box-shadow: 0 11px 30px rgba(0, 0, 0, .2); transform: translateY(-3px); }
  .theme-card-link { display: block; color: inherit; text-decoration: none; cursor: pointer; }
  .theme-menu { position: absolute; top: 10px; right: 10px; z-index: 2; }
  .theme-menu-button { width: 30px; height: 30px; display: grid; place-items: center; padding: 0; border: 1px solid rgba(255, 255, 255, .14); border-radius: 8px; background: rgba(18, 21, 26, .78); color: #d9dce1; cursor: pointer; backdrop-filter: blur(7px); transition: border-color .2s, background .2s; } .theme-menu-button img { width: 15px; height: 15px; filter: invert(1); } .theme-menu-button:hover, .theme-menu-button[aria-expanded="true"] { border-color: #70b8f5; background: rgba(28, 61, 91, .9); }
  .theme-menu-popover { position: absolute; top: 36px; right: 0; width: 112px; padding: 5px; border: 1px solid #343a44; border-radius: 9px; background: #20242b; box-shadow: 0 12px 24px rgba(0, 0, 0, .3); } .theme-menu-popover button { width: 100%; padding: 8px 9px; border: 0; border-radius: 6px; background: transparent; color: #d9dce1; text-align: left; font: inherit; font-size: 12px; cursor: pointer; } .theme-menu-popover button:hover { background: #2d3540; color: #fff; }
  .theme-preview { display: block; height: 192px; background: #20242b; } .theme-preview.has-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .theme-card-footer { justify-content: space-between; height: 55px; padding: 0 17px; border-top: 1px solid #2d3139; } .theme-name { color: #e9e8e5; font-size: 14px; font-weight: 600; }
  .card-arrow { color: #777b84; font-size: 18px; transition: color .2s, transform .2s; } .theme-card:hover .card-arrow { color: #55a8ff; transform: translate(2px, -2px); }
  .empty-state { grid-column: 1 / -1; padding: 52px 0; color: #777b84; font-size: 14px; text-align: center; }
  :global(html[data-theme='light']) body { background: #f4f7fb; color: #1f2a38; }
  :global(html[data-theme='light']) .brand, :global(html[data-theme='light']) h1 { color: #172235; }
  :global(html[data-theme='light']) .settings-button, :global(html[data-theme='light']) .mode-button { border-color: #d7e0ec; background: #ffffff; color: #5e6c80; }
  :global(html[data-theme='light']) .mode-button img, :global(html[data-theme='light']) .settings-button img { filter: none; }
  :global(html[data-theme='light']) .settings-button:hover { border-color: #a9c8e8; background: #f7fbff; color: #172235; }
  :global(html[data-theme='light']) .mode-button:hover { border-color: #a9c8e8; background: #f7fbff; color: #267bc5; }
  :global(html[data-theme='light']) .heading-copy { color: #66758a; }
  :global(html[data-theme='light']) .search-field, :global(html[data-theme='light']) .theme-card { border-color: #d7e0ec; background: #ffffff; }
  :global(html[data-theme='light']) .search-field { color: #78879a; }
  :global(html[data-theme='light']) .search-field:focus-within { border-color: #6faee4; box-shadow: 0 0 0 3px rgba(85, 168, 255, .14); }
  :global(html[data-theme='light']) .section-heading h2, :global(html[data-theme='light']) .theme-name { color: #243247; }
  :global(html[data-theme='light']) .create-theme-button { border-color: #b7d5ef; background: #eaf5ff; color: #267bc5; } :global(html[data-theme='light']) .create-theme-button:hover { border-color: #75afe0; background: #dceeff; color: #17639f; }
  :global(html[data-theme='light']) .theme-menu-button { border-color: rgba(35, 54, 75, .18); background: rgba(255, 255, 255, .86); color: #40536a; } :global(html[data-theme='light']) .theme-menu-button img { filter: none; } :global(html[data-theme='light']) .theme-menu-button:hover, :global(html[data-theme='light']) .theme-menu-button[aria-expanded="true"] { border-color: #75afe0; background: #eaf5ff; }
  :global(html[data-theme='light']) .theme-menu-popover { border-color: #d7e0ec; background: #fff; box-shadow: 0 12px 24px rgba(68, 104, 143, .16); } :global(html[data-theme='light']) .theme-menu-popover button { color: #30445c; } :global(html[data-theme='light']) .theme-menu-popover button:hover { background: #edf5fc; color: #172235; }
  :global(html[data-theme='light']) .theme-preview { background: #edf3fa; }
  :global(html[data-theme='light']) .theme-card-footer { border-color: #e4eaf2; }
  :global(html[data-theme='light']) .theme-card:hover { border-color: #75afe0; box-shadow: 0 11px 30px rgba(68, 104, 143, .12); }
  @media (max-width: 640px) { .dashboard-shell { width: min(100% - 36px, 500px); padding-top: 20px; } .page-heading { display: block; margin-top: 70px; } .search-field { width: 100%; margin-top: 28px; } .theme-section { margin-top: 52px; } .theme-grid { grid-template-columns: 1fr; } }
</style>
