---
import Layout from './_components/Layout.astro';
import settingsIcon from './assets/images/settings.svg?url';
import modeIcon from './assets/images/dark-light.svg?url';
import dotsIcon from './assets/images/three-dots-svgrepo-com.svg?url';
import adjectivesText from '../../data/theme-adjectives.txt?raw';
import nounsText from '../../data/theme-nouns.txt?raw';

const adjectives = adjectivesText.split(/\r?\n/).map((word) => word.trim()).filter(Boolean);
const nouns = nounsText.split(/\r?\n/).map((word) => word.trim()).filter(Boolean);

type Theme = {
  id: string;
  name: string;
  entryUrl: string;
  source: 'bundled' | 'user';
  image?: string;
  previewAfterLoadtime?: number;
  allowNewPreview?: boolean;
};

const themes: Theme[] = [{ id: 'dev', name: 'dev', entryUrl: '/themes/dev/', source: 'bundled', image: '/themes/dev/assets/images/preview.svg', previewAfterLoadtime: 500, allowNewPreview: true }];
---

<Layout>
  <main class="dashboard-shell">
    <header class="topbar">
      <a class="brand" href="/dashboard/" aria-label="WinDesktop dashboard home">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
        <span class="brand-name">WinDesktop</span>
      </a>
      <div class="topbar-actions">
        <button class="mode-button" type="button" data-mode-toggle aria-label="Use light mode" aria-pressed="false" title="Switch to light mode">
          <img src={modeIcon} alt="" aria-hidden="true" />
        </button>
        <button class="settings-button" type="button" aria-label="Settings" title="Settings coming soon">
          <img src={settingsIcon} alt="" aria-hidden="true" />
        </button>
      </div>
    </header>

    <section class="page-heading" aria-labelledby="page-title">
      <div>
        <p class="eyebrow">Theme library</p>
        <h1 id="page-title">Choose your desktop</h1>
        <p class="heading-copy">Pick a theme to make WinDesktop feel like yours.</p>
      </div>
      <label class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.6"></circle><path d="m16 16 5 5"></path></svg>
        <input type="search" placeholder="Search themes" aria-label="Search themes" data-theme-search />
        <kbd>/</kbd>
      </label>
    </section>

    <section class="theme-section" aria-labelledby="themes-title">
      <div class="section-heading">
        <div class="section-title"><h2 id="themes-title">All themes</h2><span class="theme-count" data-theme-count>{themes.length} theme</span></div>
        <button class="create-theme-button" type="button" data-create-theme data-adjectives={JSON.stringify(adjectives)} data-nouns={JSON.stringify(nouns)}><span aria-hidden="true">+</span>Create theme</button>
      </div>
      <div class="theme-grid" data-theme-grid>
        {themes.map((theme) => (
          <article class="theme-card" data-theme-card data-theme-id={theme.id} data-theme-source={theme.source} data-theme-name={theme.name} data-preview-after-loadtime={theme.previewAfterLoadtime ?? 0} data-allow-new-preview={theme.allowNewPreview ?? true}>
            <a class="theme-card-link" href={theme.entryUrl} aria-label={`Open ${theme.name} theme`}>
              <span class:list={["theme-preview", { "has-image": Boolean(theme.image) }]}>{theme.image && <img src={theme.image} alt="" />}</span>
              <span class="theme-card-footer"><span class="theme-name">{theme.name}</span><span class="card-arrow" aria-hidden="true">&#8599;</span></span>
            </a>
            <div class="theme-menu" data-theme-menu>
              <button class="theme-menu-button" type="button" aria-label={`Options for ${theme.name}`} aria-expanded="false" aria-haspopup="menu" data-theme-menu-button>
                <img src={dotsIcon} alt="" aria-hidden="true" />
              </button>
              <div class="theme-menu-popover" role="menu" hidden>
                <button type="button" role="menuitem" data-theme-action="duplicate">Duplicate</button>
                <button type="button" role="menuitem" data-theme-action="edit">Edit</button>
                <button type="button" role="menuitem" data-theme-action="rename">Rename</button>
                <button type="button" role="menuitem" data-theme-action="reload-preview">Reload Preview</button>
                <button type="button" role="menuitem" data-theme-action="delete">Delete</button>
              </div>
            </div>
          </article>
        ))}
        <template data-theme-template>
          <article class="theme-card" data-theme-card>
            <a class="theme-card-link" href="#" aria-label="Open theme">
              <span class="theme-preview"></span>
              <span class="theme-card-footer"><span class="theme-name"></span><span class="card-arrow" aria-hidden="true">&#8599;</span></span>
            </a>
            <div class="theme-menu" data-theme-menu>
              <button class="theme-menu-button" type="button" aria-label="Theme options" aria-expanded="false" aria-haspopup="menu" data-theme-menu-button>
                <img src={dotsIcon} alt="" aria-hidden="true" />
              </button>
              <div class="theme-menu-popover" role="menu" hidden>
                <button type="button" role="menuitem" data-theme-action="duplicate">Duplicate</button>
                <button type="button" role="menuitem" data-theme-action="edit">Edit</button>
                <button type="button" role="menuitem" data-theme-action="rename">Rename</button>
                <button type="button" role="menuitem" data-theme-action="reload-preview">Reload Preview</button>
                <button type="button" role="menuitem" data-theme-action="delete">Delete</button>
              </div>
            </div>
          </article>
        </template>
        <p class="empty-state" data-empty-state hidden>No themes found.</p>
      </div>
    </section>
    <div class="rename-dialog-backdrop" data-rename-dialog hidden>
      <form class="rename-dialog" data-rename-form>
        <div class="rename-dialog-heading">
          <div>
            <p class="eyebrow">Theme settings</p>
            <h2>Rename theme</h2>
          </div>
          <button class="rename-dialog-close" type="button" data-rename-cancel aria-label="Close rename dialog">&times;</button>
        </div>
        <label class="rename-dialog-label" for="rename-theme-input">Theme name</label>
        <input id="rename-theme-input" class="rename-dialog-input" type="text" autocomplete="off" data-rename-input />
        <p class="rename-dialog-error" data-rename-error hidden></p>
        <div class="rename-dialog-actions">
          <button class="rename-dialog-cancel" type="button" data-rename-cancel>Cancel</button>
          <button class="rename-dialog-submit" type="submit">Rename</button>
        </div>
      </form>
    </div>
  </main>
</Layout>

<script>
  import html2canvas from 'html2canvas';

  const search = document.querySelector<HTMLInputElement>('[data-theme-search]');
  let cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  const count = document.querySelector<HTMLElement>('[data-theme-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const modeButton = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  const createThemeButton = document.querySelector<HTMLButtonElement>('[data-create-theme]');
  const themeTemplate = document.querySelector<HTMLTemplateElement>('[data-theme-template]');
  const themeMenus = [...document.querySelectorAll<HTMLElement>('[data-theme-menu]')];
  const renameDialog = document.querySelector<HTMLElement>('[data-rename-dialog]');
  const renameForm = document.querySelector<HTMLFormElement>('[data-rename-form]');
  const renameInput = document.querySelector<HTMLInputElement>('[data-rename-input]');
  const renameError = document.querySelector<HTMLElement>('[data-rename-error]');
  let renameCard: HTMLElement | undefined;

  const setMode = (mode: 'light' | 'dark') => {
    document.documentElement.dataset.theme = mode;
    modeButton?.setAttribute('aria-pressed', String(mode === 'light'));
    modeButton?.setAttribute('aria-label', `Use ${mode === 'light' ? 'dark' : 'light'} mode`);
    modeButton?.setAttribute('title', `Switch to ${mode === 'light' ? 'dark' : 'light'} mode`);
    localStorage.setItem('windesktop-theme', mode);
  };

  const savedMode = localStorage.getItem('windesktop-theme');
  setMode(savedMode === 'light' ? 'light' : 'dark');
  modeButton?.addEventListener('click', () => {
    setMode(document.documentElement.dataset.theme === 'light' ? 'dark' : 'light');
  });

  const closeThemeMenus = () => {
    document.querySelectorAll<HTMLElement>('[data-theme-menu]').forEach((menu) => {
      menu.querySelector<HTMLButtonElement>('[data-theme-menu-button]')?.setAttribute('aria-expanded', 'false');
      const popover = menu.querySelector<HTMLElement>('.theme-menu-popover');
      if (popover) popover.hidden = true;
    });
  };

  const reloadThemePreview = async (menu: HTMLElement, action: HTMLButtonElement) => {
    const card = menu.closest<HTMLElement>('[data-theme-card]');
    const previewContainer = card?.querySelector<HTMLElement>('.theme-preview');
    const themeId = card?.dataset.themeId;
    if (!card || !previewContainer || !themeId) return;

    action.disabled = true;
    const originalLabel = action.textContent ?? 'Reload preview';
    action.textContent = 'Generating…';
    const frame = document.createElement('iframe');
    frame.title = `Preview of ${card.dataset.themeName ?? themeId}`;
    frame.setAttribute('aria-hidden', 'true');
    frame.style.position = 'fixed';
    frame.style.left = '-10000px';
    frame.style.top = '0';
    frame.style.width = '1200px';
    frame.style.height = '800px';
    frame.style.border = '0';
    frame.style.visibility = 'hidden';
    document.body.append(frame);

    const wait = (duration: number) => new Promise<void>((resolve) => window.setTimeout(resolve, duration));
    const waitForFrame = () => new Promise<void>((resolve, reject) => {
      frame.addEventListener('load', () => resolve(), { once: true });
      frame.addEventListener('error', () => reject(new Error('Theme preview could not be loaded')), { once: true });
    });

    try {
      frame.src = `/themes/${encodeURIComponent(themeId)}/`;
      await waitForFrame();
      const previewAfterLoadtime = Number(card.dataset.previewAfterLoadtime ?? '0');
      if (previewAfterLoadtime > 0) await wait(previewAfterLoadtime);

      const frameDocument = frame.contentDocument;
      if (!frameDocument?.body) throw new Error('Theme preview has no document body');
      await frameDocument.fonts?.ready;
      await Promise.all([...frameDocument.images].map((image) => image.decode().catch(() => undefined)));

      const canvas = await html2canvas(frameDocument.body, {
        backgroundColor: null,
        height: 800,
        width: 1200,
        windowHeight: 800,
        windowWidth: 1200,
        scale: 1,
        useCORS: true,
      });
      const png = canvas.toDataURL('image/png');
      const response = await fetch(`/api/themes/${encodeURIComponent(themeId)}/preview`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ png }),
      });
      if (!response.ok) throw new Error('Preview could not be saved');

      const imageSource = `/api/themes/${encodeURIComponent(themeId)}/preview?updated=${Date.now()}`;
      let preview = previewContainer.querySelector<HTMLImageElement>('img');
      if (!preview) {
        preview = document.createElement('img');
        preview.alt = '';
        previewContainer.append(preview);
      }
      previewContainer.classList.add('has-image');
      preview.src = imageSource;
      await preview.decode().catch(() => undefined);
    } catch (error) {
      console.error('Could not reload theme preview image', error);
    } finally {
      frame.remove();
      action.textContent = originalLabel;
      action.disabled = false;
    }
  };

  const closeRenameDialog = () => {
    renameDialog?.setAttribute('hidden', '');
    renameCard = undefined;
  };

  const openRenameDialog = (menu: HTMLElement) => {
    const card = menu.closest<HTMLElement>('[data-theme-card]');
    if (!card || card.dataset.themeSource === 'bundled') return;
    renameCard = card;
    if (renameInput) renameInput.value = card.dataset.themeName ?? '';
    if (renameError) {
      renameError.hidden = true;
      renameError.textContent = '';
    }
    renameDialog?.removeAttribute('hidden');
    window.setTimeout(() => {
      renameInput?.focus();
      renameInput?.select();
    }, 0);
  };

  const duplicateTheme = async (menu: HTMLElement, action: HTMLButtonElement) => {
    const card = menu.closest<HTMLElement>('[data-theme-card]');
    const themeId = card?.dataset.themeId;
    if (!card || !themeId) return;

    action.disabled = true;
    try {
      const response = await fetch(`/api/themes/${encodeURIComponent(themeId)}/duplicate`, { method: 'POST' });
      if (!response.ok) throw new Error('Could not duplicate theme');
      const duplicated = await response.json() as { id?: unknown; name?: unknown; entry_url?: unknown; source?: unknown; preview?: unknown; 'preview-after-loadtime'?: unknown; 'allow-new-preview'?: unknown };
      if (typeof duplicated.id !== 'string' || typeof duplicated.name !== 'string' || typeof duplicated.entry_url !== 'string') {
        throw new Error('Invalid duplicate response');
      }
      appendThemeCard(
        duplicated.name,
        duplicated.id,
        duplicated.entry_url,
        'user',
        typeof duplicated.preview === 'string' ? duplicated.preview : undefined,
        typeof duplicated['preview-after-loadtime'] === 'number' ? duplicated['preview-after-loadtime'] : 0,
        duplicated['allow-new-preview'] !== false,
      );
      filterThemes();
    } catch (error) {
      console.error('Could not duplicate theme', error);
    } finally {
      action.disabled = false;
    }
  };

  renameForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const card = renameCard;
    const themeId = card?.dataset.themeId;
    const name = renameInput?.value ?? '';
    if (!card || !themeId || !name.trim()) {
      if (renameError) {
        renameError.textContent = 'Enter a theme name.';
        renameError.hidden = false;
      }
      return;
    }

    const submit = renameForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    try {
      const response = await fetch(`/api/themes/${encodeURIComponent(themeId)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      if (response.status === 409) {
        if (renameError) {
          renameError.textContent = 'That theme name is already in use.';
          renameError.hidden = false;
        }
        return;
      }
      if (!response.ok) {
        if (renameError) {
          renameError.textContent = 'Could not rename this theme.';
          renameError.hidden = false;
        }
        return;
      }
      const renamed = await response.json() as { id?: unknown; name?: unknown; entry_url?: unknown };
      if (typeof renamed.id !== 'string' || typeof renamed.name !== 'string') throw new Error('Invalid rename response');
      card.dataset.themeId = renamed.id;
      card.dataset.themeName = renamed.name;
      card.querySelector<HTMLElement>('.theme-name')!.textContent = renamed.name;
      card.querySelector<HTMLAnchorElement>('.theme-card-link')?.setAttribute('aria-label', `Open ${renamed.name} theme`);
      if (typeof renamed.entry_url === 'string') card.querySelector<HTMLAnchorElement>('.theme-card-link')?.setAttribute('href', renamed.entry_url);
      closeRenameDialog();
      filterThemes();
    } catch (error) {
      console.error('Could not rename theme', error);
      if (renameError) {
        renameError.textContent = 'Could not rename this theme.';
        renameError.hidden = false;
      }
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-rename-cancel]').forEach((button) => {
    button.addEventListener('click', closeRenameDialog);
  });

  const bindThemeMenu = (menu: HTMLElement) => {
    const menuButton = menu.querySelector<HTMLButtonElement>('[data-theme-menu-button]');
    const popover = menu.querySelector<HTMLElement>('.theme-menu-popover');
    menuButton?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      closeThemeMenus();
      if (!isOpen && popover) {
        menuButton.setAttribute('aria-expanded', 'true');
        popover.hidden = false;
      }
    });
    menu.querySelectorAll<HTMLButtonElement>('[data-theme-action]').forEach((action) => {
      action.addEventListener('click', () => {
        if (action.dataset.themeAction === 'duplicate') {
          void duplicateTheme(menu, action);
        }
        if (action.dataset.themeAction === 'reload-preview') {
          void reloadThemePreview(menu, action);
        }
        if (action.dataset.themeAction === 'rename') {
          openRenameDialog(menu);
        }
        if (action.dataset.themeAction === 'delete') {
          void deleteTheme(menu, action);
        }
        closeThemeMenus();
      });
    });
  };

  const deleteTheme = async (menu: HTMLElement, action: HTMLButtonElement) => {
    const card = menu.closest<HTMLElement>('[data-theme-card]');
    const themeId = card?.dataset.themeId;
    const themeName = card?.dataset.themeName ?? 'this theme';
    if (!card || !themeId || !window.confirm(`Delete ${themeName}? This cannot be undone.`)) return;

    action.disabled = true;
    try {
      const response = await fetch(`/api/themes/${encodeURIComponent(themeId)}`, { method: 'DELETE' });
      if (!response.ok) throw new Error('Could not delete theme');
      card.remove();
      cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
      filterThemes();
    } finally {
      action.disabled = false;
    }
  };

  themeMenus.forEach(bindThemeMenu);

  document.addEventListener('click', closeThemeMenus);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeThemeMenus();
    if (event.key === 'Escape') closeRenameDialog();
  });
  const titleCase = (word: string) => word.split(/(\s+|-)/).map((part) => /^[\s-]+$/.test(part) ? part : part.charAt(0).toUpperCase() + part.slice(1).toLowerCase()).join('');
  const pick = (words: string[]) => words[Math.floor(Math.random() * words.length)];

  const appendThemeCard = (name: string, id: string, entryUrl: string, source: 'bundled' | 'user', image?: string, previewAfterLoadtime = 0, allowNewPreview = true) => {
    const card = themeTemplate?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
    if (!card) return;
    card.dataset.themeName = name;
    card.dataset.themeId = id;
    card.dataset.themeSource = source;
    card.dataset.previewAfterLoadtime = String(previewAfterLoadtime);
    card.dataset.allowNewPreview = String(allowNewPreview);

    const link = card.querySelector<HTMLAnchorElement>('.theme-card-link');
    link?.setAttribute('href', entryUrl);
    link?.setAttribute('aria-label', `Open ${name} theme`);
    const title = card.querySelector<HTMLElement>('.theme-name');
    if (title) title.textContent = name;
    const previewContainer = card.querySelector<HTMLElement>('.theme-preview');
    if (previewContainer && image) {
      previewContainer.classList.add('has-image');
      const preview = document.createElement('img');
      preview.src = image;
      preview.alt = '';
      previewContainer.append(preview);
    }
    const menu = card.querySelector<HTMLElement>('[data-theme-menu]');
    if (menu) bindThemeMenu(menu);
    emptyState?.before(card);
    cards = [...document.querySelectorAll<HTMLElement>('[data-theme-card]')];
  };

  const restoreStoredPreview = async (card: HTMLElement) => {
    const themeId = card.dataset.themeId;
    const previewContainer = card.querySelector<HTMLElement>('.theme-preview');
    if (!themeId || !previewContainer) return;

    try {
      const response = await fetch(`/api/themes/${encodeURIComponent(themeId)}/preview`, { cache: 'no-store' });
      if (!response.ok) return;
      let preview = previewContainer.querySelector<HTMLImageElement>('img');
      if (!preview) {
        preview = document.createElement('img');
        preview.alt = '';
        previewContainer.append(preview);
      }
      previewContainer.classList.add('has-image');
      preview.src = `/api/themes/${encodeURIComponent(themeId)}/preview?updated=${Date.now()}`;
    } catch {
      // Keep the bundled/static preview when the API is unavailable.
    }
  };

  const loadCreatedThemes = async () => {
    try {
      const response = await fetch('/api/themes');
      if (!response.ok) return;
      const createdThemes = await response.json() as Array<{ id?: unknown; name?: unknown; entry_url?: unknown; source?: unknown; preview?: unknown; 'preview-after-loadtime'?: unknown; 'allow-new-preview'?: unknown }>;
      createdThemes.forEach((theme) => {
        if (typeof theme.id === 'string' && typeof theme.name === 'string' && typeof theme.entry_url === 'string' && theme.name.trim()) {
          appendThemeCard(
            theme.name,
            theme.id,
            theme.entry_url,
            theme.source === 'bundled' ? 'bundled' : 'user',
            typeof theme.preview === 'string' ? theme.preview : undefined,
            typeof theme['preview-after-loadtime'] === 'number' ? theme['preview-after-loadtime'] : 0,
            theme['allow-new-preview'] !== false,
          );
        }
      });
      filterThemes();
      void Promise.all(cards.map(restoreStoredPreview));
    } catch {
      // Bundled themes remain available while the backend is unavailable.
    }
  };
  void loadCreatedThemes();
  void Promise.all(cards.map(restoreStoredPreview));

  createThemeButton?.addEventListener('click', async () => {
    const adjectives = JSON.parse(createThemeButton.dataset.adjectives ?? '[]') as string[];
    const nouns = JSON.parse(createThemeButton.dataset.nouns ?? '[]') as string[];
    if (!adjectives.length || !nouns.length) return;

    const name = `${titleCase(pick(adjectives))} ${titleCase(pick(nouns))}`;
    try {
      const response = await fetch('/api/themes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name }),
      });
      if (!response.ok) return;
      const createdTheme = await response.json() as { id?: unknown; name?: unknown; entry_url?: unknown; source?: unknown; 'preview-after-loadtime'?: unknown; 'allow-new-preview'?: unknown };
      if (typeof createdTheme.id === 'string' && typeof createdTheme.name === 'string' && typeof createdTheme.entry_url === 'string') {
        appendThemeCard(
          createdTheme.name,
          createdTheme.id,
          createdTheme.entry_url,
          createdTheme.source === 'bundled' ? 'bundled' : 'user',
          undefined,
          typeof createdTheme['preview-after-loadtime'] === 'number' ? createdTheme['preview-after-loadtime'] : 0,
          createdTheme['allow-new-preview'] !== false,
        );
        filterThemes();
      }
    } catch {
      // Do not show a card unless the app persisted the theme.
    }
  });

  function filterThemes() {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matches = card.dataset.themeName?.toLowerCase().includes(query) ?? false;
      card.hidden = !matches;
      if (matches) visible += 1;
    });
    if (count) count.textContent = `${visible} ${visible === 1 ? 'theme' : 'themes'}`;
    if (emptyState) emptyState.hidden = visible !== 0;
  }
  search?.addEventListener('input', filterThemes);
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== search) {
      event.preventDefault();
      search?.focus();
    }
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  .dashboard-shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 31px 0 64px; }
  .topbar, .page-heading, .section-heading, .theme-card-footer { display: flex; align-items: center; }
  .topbar { justify-content: space-between; }
  .topbar-actions { display: flex; align-items: center; gap: 9px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: #f4f3f1; text-decoration: none; }
  .brand-mark { width: 29px; height: 29px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 3px; transform: rotate(-8deg); }
  .brand-mark span { border-radius: 4px; background: #55a8ff; }
  .brand-mark span:nth-child(2) { opacity: .75; } .brand-mark span:nth-child(3) { opacity: .56; } .brand-mark span:nth-child(4) { opacity: .32; }
  .brand-name { font-size: 15px; font-weight: 650; letter-spacing: -.01em; }
  .settings-button, .mode-button { width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border: 1px solid #2a2e36; border-radius: 12px; background: #1b1e24; color: #a4a7ad; cursor: pointer; transition: border-color .2s, color .2s, background .2s; }
  .settings-button:hover { border-color: #444a55; color: #f4f3f1; background: #22262d; }
  .settings-button img, .mode-button img { width: 21px; height: 21px; object-fit: contain; }
  .mode-button img, .settings-button img { filter: invert(1); }
