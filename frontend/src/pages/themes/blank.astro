---
const name = new URL(Astro.request.url).searchParams.get('name') ?? 'Theme';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name}</title>
  </head>
  <body aria-label={name}></body>
</html>

<style>
  :global(html), :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
    background: #fff;
  }

  :global(body) { min-height: 100vh; }
</style>
