{
  "name": "webskin",
  "private": true,
  "scripts": {
    "dev": "pnpm build:assets && pnpm --parallel --filter @webskin/frontend --filter @webskin/backend --filter @webskin/common --filter @webskin/themes run dev",
    "dev:frontend": "pnpm --filter @webskin/frontend dev",
    "dev:backend": "pnpm --filter @webskin/backend dev",
    "dev:common": "pnpm --filter @webskin/common dev",
    "dev:themes": "pnpm --filter @webskin/themes dev",
    "build:common": "pnpm --filter @webskin/common build",
    "build:themes": "pnpm --filter @webskin/themes build",
    "build:assets": "pnpm build:common && pnpm build:themes",
    "build": "pnpm build:assets && pnpm --filter @webskin/frontend build"
  }
}
